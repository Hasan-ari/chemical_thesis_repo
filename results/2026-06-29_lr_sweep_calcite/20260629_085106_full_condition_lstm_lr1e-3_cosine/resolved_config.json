{
  "name": "full_condition_lstm_lr1e-3_cosine",
  "run_root": "/content/chemical_thesis_repo/runs",
  "data": {
    "datasets": [
      {
        "name": "calcite_wat_sat_data_3",
        "rock": "Calcite",
        "path": "/content/data/wat_sat/Calcite/Calcite_wat_sat_data_3",
        "max_runs": null
      },
      {
        "name": "dolomite_wat_sat_data_2",
        "rock": "Dolomite",
        "path": "/content/data/wat_sat/Dolomite/Dolomite_wat_sat_data_2",
        "max_runs": null
      }
    ],
    "processed_root": "/content/chemical_thesis_repo/processed",
    "use_cache": true,
    "rebuild_cache": false,
    "write_outputs_csv": false,
    "split": {
      "train": 0.8,
      "val": 0.1,
      "test": 0.1,
      "seed": 42,
      "strategy": "rock_aware_run_level"
    }
  },
  "model": {
    "hidden_size": 128,
    "num_layers": 2,
    "dropout": 0.0
  },
  "training": {
    "epochs": 100,
    "batch_size": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "num_workers": 2,
    "seed": 42,
    "scheduler": {
      "type": "cosine",
      "factor": 0.5,
      "patience": 10,
      "min_lr": 1e-06,
      "step_size": 50,
      "gamma": 0.5
    }
  },
  "plots": {
    "max_runs": 5,
    "features": "all"
  }
}